source_relative <- function(path, ...) {
caller_file <- sys.frame(1)$ofile
if (is.null(caller_file)) {
stop("source_relative() must be called from a sourced script.")
}
source(file.path(dirname(normalizePath(caller_file)), path), ...)
}
